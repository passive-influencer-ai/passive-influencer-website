---
const linkedInUrl = 'https://www.linkedin.com/';
---

<footer class="mx-auto w-full max-w-7xl px-5 pb-16 pt-4 md:px-10 md:pb-20">
  <h2 class="text-[clamp(2.6rem,8vw,5rem)] font-bold leading-[0.95] tracking-[-0.045em] text-paper">
    Build it with us.
  </h2>

  <div class="mt-12 flex flex-col items-start justify-between gap-10 sm:flex-row sm:items-end">
    <a
      href={linkedInUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-3 rounded-full border border-lime px-5 py-3 text-sm font-semibold tracking-[-0.01em] text-paper transition-colors duration-300 hover:bg-lime hover:text-ink"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5 fill-lime transition-colors duration-300 group-hover:fill-ink" aria-hidden="true">
        <path
          d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.34h4.52V24H.24V8.34zM8.34 8.34h4.33v2.13h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V24h-4.52v-7.75c0-1.85-.03-4.22-2.57-4.22-2.57 0-2.96 2.01-2.96 4.09V24H8.34V8.34z"
        ></path>
      </svg>
      <span>Connect with us on LinkedIn</span>
    </a>

    <a
      href={linkedInUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block overflow-hidden rounded-2xl bg-paper p-3 shadow-[0_0_0_1px_rgba(255,255,255,0.08)] transition-transform duration-300 hover:scale-[1.02]"
      aria-label="Open LinkedIn via QR code"
    >
      <img
        src="/qr-linkedin.png"
        alt="QR code linking to LinkedIn"
        width="148"
        height="148"
        class="block h-36 w-36"
        loading="lazy"
      />
    </a>
  </div>
</footer>
