---
const email = 'hello@passiveinfluencer.ai';
const waitlistUrl = `mailto:${email}?subject=I%20want%20to%20join%20the%20waitlist`;
---

<footer class="mx-auto w-full max-w-7xl px-5 pb-16 pt-4 md:px-10 md:pb-20">
  <h2 class="text-[clamp(2.6rem,8vw,5rem)] font-bold leading-[0.95] tracking-[-0.045em] text-paper">
    Build it with us.
  </h2>

  <div class="mt-12 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
    <a
      href={waitlistUrl}
      class="inline-flex items-center gap-3 rounded-full bg-lime px-6 py-3.5 text-base font-semibold tracking-[-0.01em] text-coal transition-transform duration-300 hover:-rotate-2 hover:scale-[1.03]"
    >
      <span>Join the waitlist</span>
    </a>

    <a
      href={`mailto:${email}`}
      class="text-base font-medium tracking-[-0.01em] text-paper/75 underline decoration-lime-text underline-offset-4 transition-colors duration-300 hover:text-paper"
    >
      {email}
    </a>
  </div>
</footer>
