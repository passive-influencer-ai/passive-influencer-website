---
interface Props {
  label: string;
  title: string;
  description: string;
  accent: 'lime' | 'pink' | 'butter';
  screen: 'trends' | 'plan' | 'deals';
  screenLabel: string;
  reverse?: boolean;
}

const { label, title, description, accent, screen, screenLabel, reverse = false } = Astro.props;

const accentText = {
  lime: 'text-lime-text',
  pink: 'text-pink-text',
  butter: 'text-butter-text',
}[accent];

---

<article
  data-reveal
  class="grid items-center gap-8 overflow-hidden rounded-[2rem] bg-ink-elevated p-6 md:grid-cols-2 md:gap-12 md:p-12"
>
  <div class:list={['flex flex-col', reverse && 'md:order-2']}>
    <div class="mb-8 h-14" aria-hidden="true">
      {accent === 'lime' && <span data-feature-shape class="block h-14 w-14 rounded-full bg-lime"></span>}
      {accent === 'pink' && <span data-feature-shape class="mt-3 block h-9 w-20 -rotate-12 rounded-full bg-pink"></span>}
      {
        accent === 'butter' && (
          <span data-feature-shape class="mt-2 block h-12 w-20 overflow-hidden rounded-t-full">
            <span class="block h-full w-full rounded-t-full bg-butter"></span>
          </span>
        )
      }
    </div>

    <p class={`text-base font-semibold tracking-[-0.01em] ${accentText}`}>{label}</p>
    <h3 class="mt-3 text-[clamp(1.9rem,3.6vw,3rem)] font-bold leading-[1.05] tracking-[-0.04em] text-paper">
      {title}
    </h3>
    <p class="mt-5 max-w-md text-lg leading-relaxed text-paper/75">{description}</p>
  </div>

  <div
    data-feature-panel={screen}
    class="feature-panel relative -mx-6 aspect-[5/4] overflow-clip rounded-[1.5rem] md:mx-0"
    style={`--accent: var(--color-${accent})`}
    role="group"
    aria-label={screenLabel}
  >
    <span class:list={['panel-shape', `panel-shape-${accent}`]} aria-hidden="true"></span>
    <slot />
    <span class="panel-caption" aria-hidden="true">Illustrative example</span>
  </div>
</article>

<style>
  /* Big, lighter versions of the card's brand shape behind the device. */
  .panel-shape {
    position: absolute;
    background: var(--accent-tint);
  }

  .panel-shape-lime {
    right: -18%;
    top: -30%;
    width: 75%;
    aspect-ratio: 1;
    border-radius: 999px;
  }

  .panel-shape-pink {
    left: -20%;
    top: 34%;
    width: 140%;
    height: 34%;
    border-radius: 999px;
    transform: rotate(-12deg);
  }

  .panel-shape-butter {
    left: -12%;
    bottom: -8%;
    width: 85%;
    aspect-ratio: 2 / 1;
    border-radius: 999px 999px 0 0;
  }

  .panel-caption {
    position: absolute;
    left: 4%;
    top: 3.2%;
    font-size: max(0.6rem, 1.9cqw);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(18 18 18 / 0.6);
  }
</style>
