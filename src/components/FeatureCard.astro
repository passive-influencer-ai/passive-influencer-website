---
interface Props {
  label: string;
  title: string;
  description: string;
  accent: 'lime' | 'pink' | 'butter';
  hint: string;
  reverse?: boolean;
}

const { label, title, description, accent, hint, reverse = false } = Astro.props;

const accentText = {
  lime: 'text-lime-text',
  pink: 'text-pink-text',
  butter: 'text-butter-text',
}[accent];

const accentBg = {
  lime: 'bg-lime',
  pink: 'bg-pink',
  butter: 'bg-butter',
}[accent];
---

<article
  data-reveal
  class="grid items-center gap-8 overflow-hidden rounded-[2rem] bg-ink-elevated p-6 md:grid-cols-2 md:gap-12 md:p-12"
>
  <div class:list={['flex flex-col', reverse && 'md:order-2']}>
    <div class="mb-8 h-14" aria-hidden="true">
      {accent === 'lime' && <span data-feature-shape class="block h-14 w-14 rounded-full bg-lime"></span>}
      {accent === 'pink' && <span data-feature-shape class="mt-3 block h-9 w-20 -rotate-12 rounded-full bg-pink"></span>}
      {
        accent === 'butter' && (
          <span data-feature-shape class="mt-2 block h-12 w-20 overflow-hidden rounded-t-full">
            <span class="block h-full w-full rounded-t-full bg-butter"></span>
          </span>
        )
      }
    </div>

    <p class={`text-base font-semibold tracking-[-0.01em] ${accentText}`}>{label}</p>
    <h3 class="mt-3 text-[clamp(1.9rem,3.6vw,3rem)] font-bold leading-[1.05] tracking-[-0.04em] text-paper">
      {title}
    </h3>
    <p class="mt-5 max-w-md text-lg leading-relaxed text-paper/75">{description}</p>
  </div>

  <div
    class="feature-screen relative aspect-[4/3] w-full overflow-hidden rounded-[1.5rem] bg-ink-soft p-5 md:p-7"
    role="img"
    aria-label={`Placeholder screen: ${hint}`}
  >
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-paper/15"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-paper/15"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-paper/15"></span>
    </div>

    <div class="mt-6 flex flex-col gap-3" aria-hidden="true">
      <span class="shimmer h-4 w-2/3 rounded-full"></span>
      <span class="shimmer h-4 w-1/2 rounded-full"></span>
      <span class="shimmer mt-3 h-24 w-full rounded-2xl md:h-32"></span>
      <span class="shimmer h-4 w-3/4 rounded-full"></span>
    </div>

    <span
      class={`absolute bottom-5 right-5 inline-flex items-center gap-2 rounded-full ${accentBg} px-4 py-2 text-sm font-semibold text-coal md:bottom-7 md:right-7`}
      aria-hidden="true"
    >
      <span class="h-2 w-2 rounded-full bg-coal"></span>
      {hint}
    </span>
  </div>
</article>
