---
const linkedInUrl = 'https://www.linkedin.com/';
---

<section
  data-hero
  class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-between gap-6 px-5 pb-8 pt-2 md:px-10 md:pb-12"
>
  <div class="flex flex-1 items-center">
    <h1 class="hero-title w-full font-bold text-paper">
      <span class="sr-only">Influence, on autopilot.</span>
      <span class="block" aria-hidden="true">
        <span data-line class="line block">Influ<span data-coin class="coin">e<span class="coin-cap">e</span></span>nce,</span>
      </span>
      <span class="block text-right" aria-hidden="true">
        <span data-line class="line inline-block"><span class="pill-word"><span data-pill class="pill"></span><span class="relative">on</span></span> aut<span data-dot-wrap class="dot-wrap"><span data-dot class="dot"></span></span>pilot<span data-stop class="stop"></span></span>
      </span>
    </h1>
  </div>

  <div data-hero-copy class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-10">
    <p class="max-w-2xl text-[clamp(1.15rem,2.2vw,1.85rem)] leading-snug tracking-[-0.02em] text-paper/85">
      A technology platform we&apos;re building for
      {' '}
      <span class="font-semibold text-lime">influencers who run their own business</span>
      {' '}
      - and the firms behind their marketing.
    </p>

    <a
      href={linkedInUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex shrink-0 items-center gap-3 self-start rounded-full bg-lime px-6 py-3.5 text-base font-semibold tracking-[-0.01em] text-ink transition-transform duration-300 hover:-rotate-2 hover:scale-[1.03] md:self-auto"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5 fill-ink" aria-hidden="true">
        <path
          d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.34h4.52V24H.24V8.34zM8.34 8.34h4.33v2.13h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V24h-4.52v-7.75c0-1.85-.03-4.22-2.57-4.22-2.57 0-2.96 2.01-2.96 4.09V24H8.34V8.34z"
        ></path>
      </svg>
      <span>Connect with us on LinkedIn</span>
    </a>
  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(2.7rem, min(13.6vw, 21svh), 11rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    perspective: 900px;
  }

  .coin {
    position: relative;
    display: inline-block;
    cursor: pointer;
    transform-style: preserve-3d;
  }

  .coin-cap {
    position: absolute;
    inset: 0;
    color: var(--color-butter);
    clip-path: inset(0 0 var(--coin-cut, 47%) 0);
  }

  .pill-word {
    position: relative;
    display: inline-block;
    isolation: isolate;
    margin-inline: 0.12em 0.04em;
    color: var(--color-ink);
    cursor: pointer;
  }

  .pill {
    position: absolute;
    z-index: -1;
    inset: 22% -0.16em 2% -0.16em;
    border-radius: 999px;
    background: var(--color-pink);
    transform: rotate(-6deg);
  }

  .dot-wrap {
    display: inline-block;
    margin-inline: 0.03em 0.02em;
  }

  .dot {
    display: inline-block;
    width: 0.53em;
    height: 0.53em;
    border-radius: 999px;
    background: var(--color-lime);
    cursor: pointer;
  }

  .stop {
    display: inline-block;
    width: 0.17em;
    height: 0.17em;
    margin-left: 0.05em;
    background: var(--color-lime);
    cursor: grab;
    touch-action: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { Draggable } from 'gsap/Draggable';

  gsap.registerPlugin(ScrollTrigger, Draggable);

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduceMotion) {
    const lines = hero.querySelectorAll<HTMLElement>('[data-line]');
    const coin = hero.querySelector<HTMLElement>('[data-coin]');
    const pill = hero.querySelector<HTMLElement>('[data-pill]');
    const pillWord = pill?.parentElement;
    const dotWrap = hero.querySelector<HTMLElement>('[data-dot-wrap]');
    const dot = hero.querySelector<HTMLElement>('[data-dot]');
    const stop = hero.querySelector<HTMLElement>('[data-stop]');
    const copy = hero.querySelector<HTMLElement>('[data-hero-copy]');

    // Entrance: lines rise, then each shape lands in its letter.
    const intro = gsap.timeline({ defaults: { ease: 'power4.out' } });
    intro
      .from(lines, { yPercent: 70, rotate: 4, opacity: 0, duration: 1, stagger: 0.14 })
      .from(coin, { rotationY: -540, duration: 1.3, ease: 'back.out(1.4)' }, 0.25)
      .from(pill, { scaleX: 0, transformOrigin: '0% 50%', duration: 0.8, ease: 'back.out(2)' }, 0.55)
      .from(dot, { scale: 0, duration: 0.9, ease: 'elastic.out(1, 0.45)' }, 0.7)
      .from(stop, { y: '-1.6em', rotate: -90, opacity: 0, duration: 0.9, ease: 'bounce.out' }, 0.85)
      .from(copy, { y: 24, opacity: 0, duration: 0.8 }, 0.9);

    // Click or hover the first "e" to flip it like a coin.
    let flipping = false;
    const flipCoin = () => {
      if (!coin || flipping) return;
      flipping = true;
      gsap.to(coin, {
        rotationY: '+=360',
        duration: 0.9,
        ease: 'back.out(1.6)',
        onComplete: () => {
          flipping = false;
        },
      });
    };
    coin?.addEventListener('pointerenter', flipCoin);
    coin?.addEventListener('click', flipCoin);

    // The pill wobbles when tapped.
    pillWord?.addEventListener('click', () => {
      gsap.fromTo(pill, { scaleX: 1.12, scaleY: 0.85 }, { scaleX: 1, scaleY: 1, duration: 0.9, ease: 'elastic.out(1.1, 0.3)' });
    });

    // The "o" hops and squashes when tapped.
    dot?.addEventListener('click', () => {
      gsap
        .timeline()
        .to(dot, { y: '-0.35em', scaleX: 0.9, scaleY: 1.1, duration: 0.25, ease: 'power2.out' })
        .to(dot, { y: 0, scaleX: 1, scaleY: 1, duration: 0.7, ease: 'bounce.out' });
    });

    // The full stop can be dragged out and springs back home.
    if (stop) {
      Draggable.create(stop, {
        type: 'x,y',
        onPress() {
          stop.style.cursor = 'grabbing';
        },
        onRelease() {
          stop.style.cursor = 'grab';
          gsap.to(stop, { x: 0, y: 0, duration: 1.1, ease: 'elastic.out(1, 0.35)' });
        },
      });
    }

    // On fine pointers the "o" and pill lean toward the cursor.
    if (window.matchMedia('(pointer: fine)').matches && dotWrap && pill) {
      const dotX = gsap.quickTo(dotWrap, 'x', { duration: 0.6, ease: 'power3.out' });
      const dotY = gsap.quickTo(dotWrap, 'y', { duration: 0.6, ease: 'power3.out' });
      const pillX = gsap.quickTo(pill, 'x', { duration: 0.8, ease: 'power3.out' });
      window.addEventListener('pointermove', (event) => {
        const rx = event.clientX / window.innerWidth - 0.5;
        const ry = event.clientY / window.innerHeight - 0.5;
        dotX(rx * 14);
        dotY(ry * 10);
        pillX(rx * 10);
      });
    }

    // Scrolling away tips the shapes over.
    const scroll = gsap.timeline({
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 },
    });
    scroll
      .to(pill, { rotation: 10, ease: 'none' }, 0)
      .to(dotWrap, { scale: 0.7, ease: 'none' }, 0)
      .to(stop, { rotation: 180, ease: 'none' }, 0);
  }
</script>
