---

<section class="relative mx-auto grid w-full max-w-6xl gap-12 overflow-hidden px-6 pb-20 pt-4 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] md:items-center md:gap-8 md:px-10 md:pb-28">
  <div class="relative z-10 max-w-xl">
    <p class="animate-rise text-sm tracking-[-0.01em] text-muted">
      ( For influencers &amp; the marketing teams behind them )
    </p>

    <h1 class="animate-rise-delay-1 mt-6 text-[clamp(2.8rem,8vw,5.5rem)] font-bold leading-[0.95] tracking-[-0.045em] text-paper">
      Influence,<br />
      <span class="relative inline-block">
        <span
          class="pointer-events-none absolute left-[-4%] top-[18%] -z-10 h-[58%] w-[108%] -rotate-6 rounded-full bg-pink"
          aria-hidden="true"
        ></span>
        on autopilot
      </span><span class="text-lime">.</span>
    </h1>

    <p class="animate-rise-delay-2 mt-8 max-w-md text-base leading-relaxed text-paper/85 md:text-lg">
      A technology platform we&apos;re building for
      {' '}
      <span class="font-semibold text-lime">influencers who run their own business</span>
      {' '}
      - and the firms behind their marketing.
    </p>
  </div>

  <div class="relative mx-auto aspect-square w-full max-w-md md:max-w-none" aria-hidden="true">
    <div class="animate-float absolute left-[8%] top-[6%] h-[62%] w-[62%] rounded-full bg-lime"></div>
    <div
      class="absolute right-[2%] top-[28%] h-[22%] w-[78%] -rotate-[28deg] rounded-full bg-pink"
    ></div>
    <div
      class="absolute bottom-[4%] left-[18%] h-[34%] w-[68%] overflow-hidden rounded-t-full"
    >
      <div class="h-full w-full rounded-t-full bg-butter"></div>
    </div>
  </div>
</section>
