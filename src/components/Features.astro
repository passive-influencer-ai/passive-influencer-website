---
import FeatureCard from './FeatureCard.astro';
import TrendsScreen from './screens/TrendsScreen.astro';
import PlanScreen from './screens/PlanScreen.astro';
import DealsScreen from './screens/DealsScreen.astro';

const features = [
  {
    label: 'Create',
    title: 'Trends, turned into ideas.',
    description:
      'Pick the sources and topics you care about. Our agents catch the trends that matter and turn them into content ideas for you to review.',
    accent: 'lime' as const,
    screen: 'trends' as const,
    screenLabel:
      'Illustration: agents read the sources and topics you picked, spot a trend, and suggest content ideas for you to review.',
    Screen: TrendsScreen,
  },
  {
    label: 'Plan',
    title: 'Posted at the right time.',
    description:
      "We suggest the best time to post based on your topics and content, and plan around the time you've committed to brand deals.",
    accent: 'pink' as const,
    screen: 'plan' as const,
    screenLabel:
      'Illustration: a phone app suggests the best time to post for a topic, and plans posts around brand-deal dates.',
    Screen: PlanScreen,
  },
  {
    label: 'Grow',
    title: 'Brand deals, handled.',
    description:
      'AI agents filter inbound deals for the best fit, then schedule and negotiate the ones you approve. For outbound, they find brands that match your values and growth goals, and come up with ideas to pitch.',
    accent: 'butter' as const,
    screen: 'deals' as const,
    screenLabel:
      'Illustration: agents score inbound brand deals, then schedule and negotiate the one you approve, and pitch ideas to brands that match your values.',
    Screen: DealsScreen,
  },
];
---

<section class="mx-auto w-full max-w-7xl px-5 pb-24 pt-20 md:px-10 md:pb-32 md:pt-32">
  <h2
    data-reveal
    class="max-w-4xl text-[clamp(2.2rem,5.5vw,4.5rem)] font-bold leading-[1.02] tracking-[-0.045em] text-paper"
  >
    Every tool a creator business needs, finally working as
    <span class="text-lime-text"> one.</span>
  </h2>

  <div class="mt-14 flex flex-col gap-6 md:mt-20 md:gap-8">
    {
      features.map(({ Screen, ...feature }, index) => (
        <FeatureCard {...feature} reverse={index % 2 === 1}>
          <Screen />
        </FeatureCard>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => {
      gsap.from(element, {
        y: 60,
        opacity: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: { trigger: element, start: 'top 85%' },
      });
    });

    gsap.utils.toArray<HTMLElement>('[data-feature-shape]').forEach((shape) => {
      gsap.from(shape, {
        scale: 0,
        rotate: -45,
        duration: 1,
        ease: 'elastic.out(1, 0.5)',
        scrollTrigger: { trigger: shape, start: 'top 85%' },
      });
    });
  }
</script>
