---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PassiveInfluencers | Influence, on autopilot',
  description = 'Influence, on autopilot. A technology platform for influencers who run their own business - and the firms behind their marketing.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PassiveInfluencers',
  url: Astro.site?.href,
  email: 'hello@passiveinfluencer.ai',
  description,
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PassiveInfluencers" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PassiveInfluencers: Influence, on autopilot." />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script is:inline>
      try {
        if (localStorage.getItem('pi-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
  </head>
  <body class="bg-ink text-paper antialiased">
    <slot />
  </body>
</html>
